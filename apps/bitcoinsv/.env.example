# BitcoinSV wallet: build-time settings.
#
# Copy to .env.local for a local `expo start` / `expo run:*`. EAS builds take
# them from eas.json's profiles instead (and secrets from EAS environment
# variables). Every EXPO_PUBLIC_ value is inlined into the app bundle, so none
# of them is a secret in the usual sense: API keys here are client keys.
#
# What each backend is, what BSVA supplies and what is left to switch on:
# docs/backend-integration.md.

# --- Broadcasting and headers (ARC / Chaintracks), per network ---------------
EXPO_PUBLIC_ARC_URL=https://arcade-v2-us-1.bsvblockchain.tech
EXPO_PUBLIC_ARC_API_KEY=
EXPO_PUBLIC_CHAINTRACKS_URL=https://arcade-v2-us-1.bsvblockchain.tech/chaintracks/v1
EXPO_PUBLIC_TEST_ARC_URL=https://arcade-v2-testnet-us-1.bsvblockchain.tech
EXPO_PUBLIC_TEST_ARC_API_KEY=
EXPO_PUBLIC_TEST_CHAINTRACKS_URL=https://arcade-v2-testnet-us-1.bsvblockchain.tech/chaintracks/v1
EXPO_PUBLIC_TERATEST_ARC_URL=
EXPO_PUBLIC_TERATEST_ARC_API_KEY=
EXPO_PUBLIC_TERATEST_CHAINTRACKS_URL=

# --- Chain lookups (WhatsOnChain / TAAL client keys) -------------------------
EXPO_PUBLIC_WOC_API_KEY=
EXPO_PUBLIC_TEST_WOC_API_KEY=
EXPO_PUBLIC_TEST_TAAL_API_KEY=
EXPO_PUBLIC_TERATEST_WOC_API_KEY=

# --- Messages: payments, requests, push registration (MessageBox) ------------
EXPO_PUBLIC_DEFAULT_MESSAGEBOX_URL=https://messagebox.bsvblockchain.tech

# --- Identity overlay (Mandala), per network ---------------------------------
EXPO_PUBLIC_MANDALA_OVERLAY_URL=
EXPO_PUBLIC_MANDALA_OVERLAY_IDENTITY_KEY=
EXPO_PUBLIC_MANDALA_MESSAGEBOX_URL=
EXPO_PUBLIC_TEST_MANDALA_OVERLAY_URL=https://mandala-test-overlay.bsvblockchain.tech
EXPO_PUBLIC_TEST_MANDALA_OVERLAY_IDENTITY_KEY=0215643bc656ca42007faa32e94f70050f64a566ffd9e3a2ebc098389936dea57e
EXPO_PUBLIC_TEST_MANDALA_MESSAGEBOX_URL=https://messagebox.bsvblockchain.tech

# --- Handles (@name), per network --------------------------------------------
# Development registry: deggen.com on the MessageBox host. Production:
# bitcoinsv.com, at a registry URL BSVA has yet to supply. Empty URL = Profile
# shows handles as not available.
EXPO_PUBLIC_HANDLE_REGISTRY_DOMAIN=deggen.com
EXPO_PUBLIC_HANDLE_REGISTRY_URL=https://messagebox.bsvblockchain.tech
EXPO_PUBLIC_TEST_HANDLE_REGISTRY_DOMAIN=deggen.com
EXPO_PUBLIC_TEST_HANDLE_REGISTRY_URL=https://messagebox.bsvblockchain.tech

# --- Backup log (Sync) -------------------------------------------------------
EXPO_PUBLIC_BACKUP_URL=https://backup.bsvblockchain.tech

# --- Vault (development and preview only; never production) -----------------
EXPO_PUBLIC_VAULT_ENABLED=true

# --- Push ----------------------------------------------------------------------
# Real push also needs firebase/GoogleService-Info.plist and
# firebase/google-services.json (not committed). Without them it stays off.
EXPO_PUBLIC_PUSH_ENABLED=true
# Development builds only: route pushes from Settings → Advanced → Push
# simulator, with nothing registered on the server.
EXPO_PUBLIC_PUSH_SIMULATE=

# --- Website links (https://<domain>/pay/… and /@handle open the app) --------
# Set only once the domain serves web/.well-known/* (see web/README.md); it
# adds the associated domains / verified intent filters to the native build.
EXPO_PUBLIC_LINK_DOMAIN=

# --- Explainer video (optional; bundled files otherwise) ---------------------
EXPO_PUBLIC_TOUR_VIDEO_URL=
EXPO_PUBLIC_TOUR_CAPTIONS_URL=

# --- Feedback and store ratings ---------------------------------------------
# Notes to the team ("I don't like it", Help → Send feedback) wait on the phone
# until this is set, then go to <url>/v1/feedback. The store ratings need the
# listings: "I love it" says ratings come later until then.
EXPO_PUBLIC_FEEDBACK_URL=
# The digits in apps.apple.com/app/id…, once the App Store listing exists.
EXPO_PUBLIC_APP_STORE_ID=
# true once the app is live on Google Play.
EXPO_PUBLIC_PLAY_STORE_LISTED=

# --- Build (not inlined) -----------------------------------------------------
# This app's own EAS project, once BSVA creates it.
BITCOINSV_EAS_PROJECT_ID=

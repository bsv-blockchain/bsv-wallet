{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../types/**/*"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android"
  ]
}

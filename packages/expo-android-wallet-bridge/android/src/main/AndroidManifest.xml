<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Normal permission; Window.setHideOverlayWindows (API 31+) needs it for the sheet's overlay protection. -->
  <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

  <application>
    <!-- The only exported component. It holds no React Native. The config plugin adds its one intent filter (the host's
         launch scheme, host "launch"); this library cannot know the scheme. -->
    <activity
      android:name="org.bsv.walletbridge.LaunchTrampolineActivity"
      android:exported="true"
      android:theme="@android:style/Theme.NoDisplay"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity="" />

    <!-- The overlay sheet over Chrome. Not exported: only the trampoline and the notification tap start it, explicitly. -->
    <activity
      android:name="org.bsv.walletbridge.BridgeSheetActivity"
      android:exported="false"
      android:launchMode="singleTask"
      android:taskAffinity="${applicationId}.bridge"
      android:excludeFromRecents="true"
      android:windowSoftInputMode="adjustResize"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|locale|layoutDirection|fontScale|density|colorMode|navigation|touchscreen"
      android:theme="@style/Theme.BsvBridgeSheet" />

    <service
      android:name="org.bsv.walletbridge.BridgeService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Loopback server that lets a web page in the phone's browser ask this wallet for approval while the browser is in front" />
    </service>
  </application>
</manifest>

+package org.bsv.walletbridge
+
+import android.content.Intent
+import android.os.Bundle
+import com.facebook.react.ReactActivity
+import com.facebook.react.ReactActivityDelegate
+import com.facebook.react.ReactApplication
+import com.facebook.react.defaults.DefaultNewArchitectureEntryPoint.fabricEnabled
+import com.facebook.react.defaults.DefaultReactActivityDelegate
+
+/** SPIKE S4 (scratch): the "hello" sheet on a second React root of the shared host. */
+class BridgeSheetActivity : ReactActivity() {
+  override fun onCreate(savedInstanceState: Bundle?) {
+    S4.sheet = this
+    super.onCreate(null)
+  }
+
+  override fun getMainComponentName(): String = "BsvBridgeSheet"
+
+  override fun createReactActivityDelegate(): ReactActivityDelegate =
+    object : DefaultReactActivityDelegate(this, mainComponentName, fabricEnabled) {
+      override fun onResume() {
+        S4.log("delegate[sheet#${System.identityHashCode(this@BridgeSheetActivity)}].onResume -> reactHost.onHostResume")
+        super.onResume()
+      }
+
+      override fun onPause() {
+        S4.log("delegate[sheet#${System.identityHashCode(this@BridgeSheetActivity)}].onPause -> reactHost.onHostPause")
+        super.onPause()
+      }
+
+      override fun onDestroy() {
+        val id = System.identityHashCode(this@BridgeSheetActivity)
+        if (S4.prop("skipdestroy") && S4.mainAlive) {
+          S4.log("delegate[sheet#$id].onDestroy VARIANT: unloadApp only, reactHost.onHostDestroy SKIPPED (mainAlive)")
+          reactDelegate?.unloadApp()
+        } else {
+          S4.log("delegate[sheet#$id].onDestroy -> reactHost.onHostDestroy")
+          super.onDestroy()
+        }
+      }
+    }
+
+  override fun onNewIntent(intent: Intent) {
+    S4.log("sheet.onNewIntent data=${intent.data} seq=${intent.getIntExtra(LaunchTrampolineActivity.EXTRA_SEQ, -1)}")
+    setIntent(Intent())
+    super.onNewIntent(intent)
+  }
+
+  override fun onBackPressed() {
+    S4.log("sheet.onBackPressed (native) variantFinish=${S4.prop("back")}")
+    if (S4.prop("back")) finish() else super.onBackPressed()
+  }
+
+  override fun onDestroy() {
+    if (S4.sheet === this) S4.sheet = null
+    super.onDestroy()
+  }
+}

@@ -0,0 +1,85 @@
+package org.bsv.walletbridge
+
+import android.app.Activity
+import android.app.Application
+import android.os.Bundle
+import android.util.Log
+import com.facebook.react.bridge.LifecycleEventListener
+import com.facebook.react.bridge.ReactContext
+import expo.modules.kotlin.AppContext
+
+/** SPIKE S4 (scratch): a minimal LifecycleTracker plus logging of Activity and React host lifecycle (tag BsvS4). */
+object S4 {
+  const val TAG = "BsvS4"
+  @Volatile var mainAlive = false
+  @Volatile var sheet: Activity? = null
+  private var registered = false
+  private val listened = java.util.Collections.newSetFromMap(java.util.WeakHashMap<Any, Boolean>())
+
+  fun log(m: String) {
+    Log.i(TAG, m)
+  }
+
+  private fun name(a: Activity) = "${a.javaClass.simpleName}#${System.identityHashCode(a)}(task=${a.taskId})"
+  private fun isMain(a: Activity) = a.javaClass.name.endsWith(".MainActivity")
+
+  fun onModuleCreate(ctx: AppContext) {
+    val rc = ctx.reactContext
+    val cur = ctx.currentActivity
+    log("module OnCreate: reactContext=${rc?.javaClass?.simpleName} currentActivity=${cur?.let { name(it) }} mainAlive(before)=$mainAlive")
+    val app = rc?.applicationContext as? Application
+    if (app != null && !registered) {
+      registered = true
+      app.registerActivityLifecycleCallbacks(
+        object : Application.ActivityLifecycleCallbacks {
+          override fun onActivityCreated(a: Activity, s: Bundle?) {
+            if (isMain(a)) mainAlive = true
+            log("activity.onCreate ${name(a)} saved=${s != null} mainAlive=$mainAlive")
+          }
+          override fun onActivityStarted(a: Activity) = log("activity.onStart ${name(a)}")
+          override fun onActivityResumed(a: Activity) {
+            if (isMain(a)) mainAlive = true
+            log("activity.onResume ${name(a)} mainAlive=$mainAlive")
+          }
+          override fun onActivityPaused(a: Activity) = log("activity.onPause ${name(a)}")
+          override fun onActivityStopped(a: Activity) = log("activity.onStop ${name(a)}")
+          override fun onActivitySaveInstanceState(a: Activity, o: Bundle) {}
+          override fun onActivityDestroyed(a: Activity) {
+            if (isMain(a)) mainAlive = false
+            log("activity.onDestroy ${name(a)} mainAlive=$mainAlive")
+          }
+        }
+      )
+    }
+    // catch-up: the module is created after MainActivity.onCreate on a cold start
+    if (cur != null && isMain(cur) && !mainAlive) {
+      mainAlive = true
+      log("catch-up: MainActivity ${name(cur)} was already alive when the tracker registered")
+    }
+    if (rc is ReactContext && listened.add(rc)) {
+      rc.addLifecycleEventListener(
+        object : LifecycleEventListener {
+          override fun onHostResume() = log("RN host.onHostResume currentActivity=${rc.currentActivity?.let { name(it) }} mainAlive=$mainAlive")
+          override fun onHostPause() = log("RN host.onHostPause currentActivity=${rc.currentActivity?.let { name(it) }} mainAlive=$mainAlive")
+          override fun onHostDestroy() = log("RN host.onHostDestroy currentActivity=${rc.currentActivity?.let { name(it) }} mainAlive=$mainAlive")
+        }
+      )
+      log("RN lifecycle listener attached")
+    }
+  }
+
+  fun prop(n: String): Boolean =
+    try {
+      val p = Runtime.getRuntime().exec(arrayOf("getprop", "debug.bsvs4.$n"))
+      p.inputStream.bufferedReader().readText().trim() == "1"
+    } catch (_: Exception) {
+      false
+    }
+
+  fun finishSheet() {
+    val s = sheet ?: return
+    s.runOnUiThread { s.finish() }
+  }
+
+  fun status() = mapOf("mainAlive" to mainAlive, "sheet" to (sheet != null))
+}

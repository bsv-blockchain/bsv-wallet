{
  "deviations": [
    {
      "id": "wait-for-authentication-sheet",
      "summary": "waitForAuthentication can raise the grouped-permission sheet for a connected origin, which conflicts with BRC-219 "probes must not prompt"; only after the user has connected the site. Where the manifest group was previewed at connect (merged Connect sheet), Connect mints it and this call no longer prompts; it prompts only for a manifest that has since gained items or when minting failed.",
    },
    {
      "id": "list-actions-deadline",
      "summary": "External listActions is subject to the vault guard's 30 s deadline and shared 16-slot queue (pre-existing); conflicts with BRC-219 "no deadline" for that method only.",
    },
    {
      "id": "sdk-http-json-clients",
      "summary": "SDK 2.8 HTTP JSON clients keep the message only for codes 5, 6 and 7 and reject isAuthenticated false.",
    },
    {
      "id": "unverified-namespace",
      "summary": "Unattested originators are rewritten into the .<grantTag>.unverified.invalid namespace: wallet-side BRC-116 policy, loopback only, never a future BRC-185 section 8 mobile profile.",
    },
    {
      "id": "request-cap",
      "summary": "Request and response caps are 5 MiB, not 64 MiB.",
    },
    {
      "id": "unsupported-contexts",
      "summary": "Non-web asserted contexts and legacy epoch-less routes are not supported in project 1.",
    },
    {
      "id": "approved-forging-app",
      "summary": "A user who approves a forging local app gets a fresh grant set plus everything the effective unverified policy leaves prompt-free; the reconnect token only stops silent reconnects, and the launch proof does not authenticate the website.",
    },
    {
      "id": "sheet-slot",
      "summary": "An unanswered connection sheet holds its transport single slot until answered or its bindings close; a second new site on that transport gets RESOURCE_LIMIT. There is no deadline.",
    },
    {
      "id": "basket-contents-shared",
      "summary": "Basket contents are not isolated between a site verified and unverified identities, or between connected sites, once basket access is granted.",
    },
    {
      "id": "manifest-fetch-hermes",
      "summary": "The SDK private-address DNS check runs only on Node; on Hermes an unverified site claimed hostname resolving to a private address is fetched, bounded by TLS, the fixed URL and port and the special-use host list.",
    },
    {
      "id": "token-module-routing-case",
      "summary": "Token-module routing is exact-case for attested callers (pre-existing); unverified bindings are covered by the dispatcher pre-scan.",
    },
    {
      "id": "sheet-modal-flag",
      "summary": "executeGrant and handleDeny close the kind modal flag unconditionally, which can strand a queued request of the same kind (pre-existing).",
    },
  ],
